{
  "name": "n8n-nodes-personyze",
  "version": "0.2.1",
  "description": "n8n node for Personyze: create and update visitors, manage audiences and the product catalog, record product interactions, and trigger on profile changes.",
  "keywords": [
    "n8n-community-node-package",
    "personyze",
    "personalization",
    "crm",
    "ab-testing"
  ],
  "license": "MIT",
  "homepage": "https://personyze.com",
  "author": {
    "name": "Personyze",
    "email": "support@personyze.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/personyze/n8n-nodes-personyze.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:assets",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PersonyzeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Personyze/Personyze.node.js",
      "dist/nodes/PersonyzeTrigger/PersonyzeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/personyze/n8n-nodes-personyze/issues"
  }
}
